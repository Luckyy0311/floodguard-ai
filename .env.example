# FloodGuard AI - Environment Variables
#
# Setup:
# 1. Copy this file to `.env` (cp .env.example .env)
# 2. Add your actual keys to `.env`
# 3. Keep `.env` out of git! (It's already in .gitignore)
# This file just has placeholders and is safe to commit.

# --------------------------------------------------
# LLM Provider
# --------------------------------------------------
# Use "openai" for OpenAI, Groq, or OpenRouter (their APIs are compatible).
# Use "ollama" if you want to run models locally without an API key.
LLM_PROVIDER=openai

# --------------------------------------------------
# OpenAI / Compatible API Keys
# --------------------------------------------------
# Paste your API key here. 
# (From OpenAI platform, Groq console, or OpenRouter)
OPENAI_API_KEY=paste-your-api-key-here

# Which model to use.
# OpenAI:     gpt-4o-mini
# Groq:       openai/gpt-oss-120b
# OpenRouter: meta-llama/llama-3.3-70b-instruct:free
OPENAI_MODEL=gpt-4o-mini

# Base URL for compatible providers. 
# Leave commented out for standard OpenAI. Uncomment the right one for Groq/OpenRouter.
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --------------------------------------------------
# Ollama (Local)
# --------------------------------------------------
# Only matters if LLM_PROVIDER=ollama.
# Remember to run `ollama pull llama3.1` before starting the app.
OLLAMA_MODEL=llama3.1

# --------------------------------------------------
# Agent Config
# --------------------------------------------------
# How many tools the agent can call in a row before stopping.
# 6 is usually plenty, but bump it up if complex answers get cut off.
MAX_TOOL_CALLS=6

# Timeout for external requests (weather APIs, etc) in seconds.
REQUEST_TIMEOUT=20

# --------------------------------------------------
# Future stuff (Maps, SMS alerts)
# --------------------------------------------------
# MAPBOX_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
